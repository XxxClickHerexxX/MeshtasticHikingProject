PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-session-secret

# Storage adapter: postgres or memory
STORAGE_ADAPTER=memory
LOCAL_DATA_FILE=data/local-data.json

# PostgreSQL (required when STORAGE_ADAPTER=postgres)
DATABASE_URL=postgresql://localhost:5432/hiking_with_confidence
AUTO_MIGRATE=false

# Meshtastic/MQTT integration
MQTT_ENABLED=false
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=meshtastic/hwc/private-route
MQTT_CLIENT_ID=hiking-with-confidence
